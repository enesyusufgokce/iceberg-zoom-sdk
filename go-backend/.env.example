PORT=8080

# Meeting SDK
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=
ZOOM_SDK_JWT_TTL=7200

# Video SDK
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=

# OAuth 2.0 (authorization code flow) - Marketplace app under
# Develop > Build App > OAuth
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=http://localhost:8080/api/zoom/oauth/callback

# Webhook (Feature > Event Subscriptions > Secret Token)
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_WEBHOOK_TIMESTAMP_TOLERANCE=300

# Zoom API endpoints (defaults shown, override only for testing against a mock)
# ZOOM_API_BASE_URL=https://api.zoom.us/v2
# ZOOM_OAUTH_TOKEN_URL=https://zoom.us/oauth/token
